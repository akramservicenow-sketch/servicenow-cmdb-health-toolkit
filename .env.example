# Copy to .env (never commit .env). All values below are placeholders.
# Use a dedicated, read-only integration user (see README > Security).

SN_INSTANCE_URL=https://your-instance.service-now.com

# basic | oauth
SN_AUTH_MODE=oauth

# OAuth (preferred). Create an OAuth API endpoint for external clients in
# System OAuth > Application Registry.
SN_CLIENT_ID=<your-oauth-client-id>
SN_CLIENT_SECRET=<your-oauth-client-secret>
# client_credentials | password
SN_OAUTH_GRANT=client_credentials

# Basic auth, or the resource owner for the OAuth password grant.
SN_USERNAME=<read-only-integration-user>
SN_PASSWORD=<set-in-your-secret-store>

# Tuning (optional)
SN_TIMEOUT=30
SN_PAGE_SIZE=500
SN_MAX_RETRIES=4
SN_VERIFY_TLS=true
